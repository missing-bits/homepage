---
interface Props {
  title: string;
  url: string;
  description: string;
  tags: string[];
}
const { title, url, description, tags } = Astro.props;
---
<a class="card" href={url}>
  <h3>{title}</h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
</a>

<style>
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--brand-cyan);
    border: 1px solid var(--brand-navy);
    border-radius: 0.35rem;
    padding: 0.1rem 0.5rem;
  }
</style>
