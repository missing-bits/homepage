---
import projects from '../data/projects.json';
import { t, type Locale } from '../i18n';

interface Props { locale: Locale }
const s = t(Astro.props.locale);
const items = projects as Array<{
  slug: string;
  title: string;
  url: string;
  category?: string;
  tags?: string[];
}>;
const descriptions = s.projects.descriptions as Record<string, string>;
const categoryLabels = s.projects.categories as Record<string, string>;
// Group by category preserving first-appearance order; uncategorized ('') first.
const order = [...new Set(items.map((p) => p.category ?? ''))].sort((a, b) =>
  a === '' ? -1 : b === '' ? 1 : 0
);
const groups = order.map((cat) => ({
  cat,
  entries: items.filter((p) => (p.category ?? '') === cat),
}));
---
{items.length > 0 && (
  <section id="projects">
    <h2>{s.projects.heading}</h2>
    {groups.map(({ cat, entries }) => (
      <>
        {cat && <h3 class="project-category">{categoryLabels[cat] ?? cat}</h3>}
        <div class="card-grid">
          {entries.map((p) => (
            <a class="card" href={p.url}>
              <h3>{p.title}</h3>
              <p>{descriptions[p.slug] ?? ''}</p>
              {(p.tags ?? []).length > 0 && (
                <ul class="tags">
                  {p.tags!.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </a>
          ))}
        </div>
      </>
    ))}
  </section>
)}

<style>
  .project-category {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--muted);
    margin: 2rem 0 1rem;
  }
  .project-category::before { content: '# '; color: var(--brand-cyan); }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--brand-cyan);
    border: 1px solid var(--brand-navy);
    border-radius: 0.35rem;
    padding: 0.1rem 0.5rem;
  }
</style>
